# string_lib_demo — exercises every sub in libraries/string_lib.bare.
#
# This program calls no subs of its own — it expects string_lib.bare to
# already be loaded into My Library (My Library panel -> Edit Library
# File..., paste in libraries/string_lib.bare's contents) before you run it.
# BARE has no import; the IDE loads your personal library automatically
# before your program runs (see libraries/README.md).

print "str_reverse:"
print str_reverse("hello")

print "str_to_upper:"
print str_to_upper("Hello, World!")

print "str_to_lower:"
print str_to_lower("Hello, World!")

print "str_to_title:"
print str_to_title("the quick brown fox")

print "str_substring:"
print str_substring("hello", 1, 3)

print "str_index_of:"
print str_index_of("hello world", "world")
print str_index_of("hello world", "xyz")

print "str_contains:"
print str_contains("hello world", "lo wo")
print str_contains("hello world", "xyz")

print "str_starts_with:"
print str_starts_with("hello world", "hello")
print str_starts_with("hello world", "world")

print "str_ends_with:"
print str_ends_with("hello world", "world")
print str_ends_with("hello world", "hello")

print "str_count_occurrences:"
print str_count_occurrences("banana", "an")
print str_count_occurrences("banana", "xy")

print "str_trim:"
print "[" + str_trim("   padded string   ") + "]"

print "str_split:"
print str_split("a,b,c,d", ",")

print "str_join:"
print str_join(["a", "b", "c", "d"], "-")

print "str_pad_left:"
print "[" + str_pad_left("42", 6, "0") + "]"

print "str_pad_right:"
print "[" + str_pad_right("42", 6, "*") + "]"

print "str_repeat:"
print str_repeat("ab", 3)

print "str_replace:"
print str_replace("one two one two", "one", "1")

print "str_is_numeric:"
print str_is_numeric("-3.14")
print str_is_numeric("12abc")

print "str_equals_ignore_case:"
print str_equals_ignore_case("HELLO", "hello")
print str_equals_ignore_case("HELLO", "world")
